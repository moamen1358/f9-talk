# Optional. The easy way to set a key is the Settings window (right-click
# the red dot, or "F9 Talk > Settings" in the apps menu), which stores it
# in your desktop keyring.
#
# For scripts or systems without a keyring, put the keys here and save the
# file as ~/.config/F9_talk/secrets.env (chmod 600), or export them as
# environment variables (those win over saved keys).

# AssemblyAI (the default service): https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=

# Deepgram (backend = "deepgram" in config.toml): https://console.deepgram.com/signup
DEEPGRAM_API_KEY=
